  {
    "version": "1.4.0",
    "date": "2026-11-23",
    "previous": "1.3.1",
    "title": "A monitor can open an incident room",
    "summary": "Monitors can open incident rooms through a webhook, and Home marks the incidents they open. The open incident list keeps its place, and two fixes cover the lobby and search.",
    "audiences": [
      {
        "text": "A monitor that can send a webhook can now open an incident room when its alarm fires. The room shows the alarm, the service it names and the checks already run.",
        "covers": [
          "pr131-1"
        ]
      },
      {
        "text": "On Home, open an incident marked \"Opened by a monitor\". The first message in the room is the alarm, with a link to the monitor.",
        "covers": [
          "pr131-2"
        ],
        "for": "For responders"
      },
      {
        "text": "In Settings, open Integrations and add a webhook. Paste its address into your monitor.",
        "covers": [
          "pr131-1"
        ],
        "for": "For admins"
      }
    ],
    "entries": [
