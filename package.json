{
  "name": "basalt",
  "private": true,
  "description": "Basalt, the SRA Syndicate design system.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lint": "node scripts/lint.mjs",
    "build": "npm run build -w packages/tokens && npm run build -w packages/react && node tools/html-skill/build.mjs",
    "test": "node scripts/test-all.mjs",
    "artifact": "node tools/artifact/build.mjs && node tools/artifact/check.mjs",
    "review": "node tools/review/build.mjs",
    "test:packages": "node scripts/verify-packages.mjs",
    "typecheck:review": "tsc -p tools/review/tsconfig.json",
    "check": "node scripts/check.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "test:brand": "npm run build -w packages/tokens && node --test brand/test/*.test.mjs",
    "test:html-skill": "node --test tools/html-skill/test/*.test.mjs",
    "test:sites": "node --test sites/test/*.test.mjs",
    "html-skill:shots": "node tools/html-skill/shoot.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "stylelint": "17.16.0"
  }
}
