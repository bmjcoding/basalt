{
  "name": "@srasyndicate/basalt",
  "version": "0.1.0",
  "private": true,
  "description": "Basalt React components: Base UI primitives styled with Basalt tokens.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/headroom.d.ts",
      "default": "./dist/testing/headroom.js"
    },
    "./phosphor": {
      "types": "./dist/tooling/phosphor.d.ts",
      "default": "./dist/tooling/phosphor.js"
    },
    "./imports": {
      "types": "./dist/tooling/imports.d.ts",
      "default": "./dist/tooling/imports.js"
    },
    "./diagram-export": {
      "types": "./dist/diagram-export.d.ts",
      "default": "./dist/diagram-export.js"
    },
    "./diagram-layout": {
      "types": "./dist/diagram-layout.d.ts",
      "default": "./dist/diagram-layout.js"
    },
    "./marks/*": {
      "types": "./dist/marks/*.d.ts",
      "default": "./dist/marks/*.js"
    },
    "./head/theme.js": "./dist/head/theme.js",
    "./head/loops.js": "./dist/head/loops.js",
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "THIRD-PARTY-MARKS.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "sizes": "node test/export-sizes.mjs",
    "test": "node ../../scripts/test-react.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@srasyndicate/basalt-tokens": "0.1.0",
    "cmdk": "1.1.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "elkjs": "0.12.1",
    "esbuild": "0.28.2",
    "geist": "1.9.0",
    "playwright": "1.63.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "7.0.2"
  }
}
