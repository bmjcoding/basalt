{
  "name": "@srasyndicate/basalt",
  "version": "0.1.0",
  "private": true,
  "description": "Basalt React components: Base UI primitives styled with Basalt tokens.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run typecheck && node build.mjs && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@srasyndicate/basalt-tokens": "0.1.0",
    "cmdk": "1.1.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "geist": "1.9.0",
    "playwright": "1.63.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "7.0.2"
  }
}
