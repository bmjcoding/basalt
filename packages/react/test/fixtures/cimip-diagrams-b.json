  "dataFlow": {
    "type": "data-flow",
    "title": "How one message reaches everyone in the room",
    "source": "\"The log\"",
    "summary": "Marcus's browser posts a message to cimip task A, which inserts an event row and fires NOTIFY in one Aurora transaction. Every cimip task listens and streams the event over SSE to Priya's browser, while Aurora keeps the newest 300 rows and seals older batches of 200 to S3.",
    "legend": {
      "main": "The message's path",
      "plain": "Housekeeping",
      "dashed": "Later, in a batch",
      "focal": "Where the event is written"
    },
    "lanes": [
      {
        "id": "marcus",
        "label": "Marcus's browser"
      },
      {
        "id": "task-a",
        "label": "cimip task A"
      },
      {
        "id": "aurora",
        "label": "Aurora"
      },
      {
        "id": "task-b",
        "label": "cimip task B"
      },
      {
        "id": "priya",
        "label": "Priya's browser"
      },
      {
        "id": "s3",
        "label": "S3"
      }
    ],
    "nodes": [
      {
        "id": "send",
        "lane": "marcus",
        "name": "Sends a message",
        "detail": "POST · retry key",
        "detailMono": true,
        "col": 1
      },
      {
        "id": "append",
        "lane": "task-a",
        "name": "Appends it",
        "detail": "row lock → next seq",
        "detailMono": true,
        "col": 2
      },
      {
        "id": "row",
        "lane": "aurora",
        "name": "Event row + NOTIFY",
        "detail": "one transaction",
        "focal": true,
        "col": 3
      },
      {
        "id": "hear",
        "lane": "task-b",
        "name": "Hears it",
        "detail": "LISTEN, every task",
        "detailMono": true,
        "col": 4
      },
      {
        "id": "see",
        "lane": "priya",
        "name": "Sees it",
        "detail": "SSE · one stream a tab",
        "detailMono": true,
        "col": 5
      },
      {
        "id": "seal",
        "lane": "aurora",
        "name": "Keeps the newest 300",
        "detail": "older rows deleted once sealed",
        "col": 2
      },
      {
        "id": "seg",
        "lane": "s3",
        "name": "Sealed segment",
        "detail": "200 events · SHA-256",
        "detailMono": true,
        "col": 3
      }
    ],
    "edges": [
      {
        "from": "send",
        "to": "append",
        "kind": "main"
      },
      {
        "from": "append",
        "to": "row",
        "kind": "main",
        "label": "INSERT"
      },
      {
        "from": "row",
        "to": "hear",
        "kind": "main",
        "label": "NOTIFY"
      },
      {
        "from": "hear",
        "to": "see",
        "kind": "main",
        "label": "SSE"
      },
      {
        "from": "row",
        "to": "seal",
        "label": "trim"
      },
      {
        "from": "row",
        "to": "seg",
        "kind": "dashed",
        "label": "once 200 wait"
      }
    ]
  },
  "sequence": {
    "type": "sequence",
    "title": "An @agent run, from the mention to the approved action",
    "source": "\"Runs and sandboxes\" and the agent contract",
    "summary": "Marcus mentions @agent in the room. The cimip service records the run, starts and health-checks an ECS sandbox on the incident's first run, posts the run, streams the turn back to Marcus, and relays Marcus's approval until the sandbox says it is done.",
    "legend": {
      "main": "Request",
      "plain": "Setup",
      "dashed": "Stream or reply",
      "focal": "The service",
      "activation": "Working"
    },
    "participants": [
      {
        "id": "marcus",
        "kind": "person",
        "name": "Marcus, in the room",
        "short": "Marcus"
      },
      {
        "id": "svc",
        "kind": "ECS service",
        "name": "cimip service",
        "focal": true
      },
      {
        "id": "ecs",
        "kind": "control plane",
        "name": "ECS"
      },
      {
        "id": "agent",
        "kind": "ECS task",
        "name": "Agent sandbox"
      }
    ],
    "steps": [
      {
        "from": "marcus",
        "to": "svc",
        "kind": "main",
        "label": "@agent check the proxy",
        "note": "a message in the room",
        "activate": true
      },
      {
        "from": "svc",
        "to": "svc",
        "label": "records the run",
        "note": "run.started, one transaction"
      },
      {
        "frame": "opt",
        "label": "First run on an incident only",
        "steps": [
          {
            "from": "svc",
            "to": "ecs",
            "label": "RunTask",
            "note": "idempotency token = sandbox id"
          },
          {
            "frame": "loop",
            "label": "Until private IP",
            "steps": [
              {
                "from": "svc",
                "to": "ecs",
                "label": "DescribeTasks",
                "note": "until it has a private IP"
              }
            ]
          },
          {
            "from": "svc",
            "to": "agent",
            "label": "GET /healthz",
            "note": "up to a minute"
          }
        ]
      },
      {
        "band": "Every run"
      },
      {
        "from": "svc",
        "to": "agent",
        "kind": "main",
        "label": "POST /v1/runs",
        "note": "facts, recent transcript, prompt",
        "activate": true
      },
      {
        "from": "agent",
        "to": "svc",
        "kind": "dashed",
        "label": "events, over SSE",
        "note": "status · tool.started · finding"
      },
      {
        "from": "svc",
        "to": "marcus",
        "kind": "dashed",
        "label": "the turn, as it happens",
        "note": "text in 40 ms frames, not stored"
      },
      {
        "from": "agent",
        "to": "svc",
        "kind": "main",
        "label": "approval.requested",
        "note": "the exact command · risk: medium"
      },
      {
        "band": "The agent waits for a person"
      },
      {
        "frame": "alt",
        "branches": [
          {
            "label": "Approved",
            "steps": [
              {
                "from": "marcus",
                "to": "svc",
                "kind": "main",
                "label": "Approve",
                "note": "first decision stands"
              },
              {
                "from": "svc",
                "to": "agent",
                "kind": "main",
                "label": "POST /v1/runs/{id}/input",
                "note": "sent until acknowledged"
              }
            ]
          },
          {
            "label": "Rejected or timed out",
            "steps": [
              {
                "from": "svc",
                "to": "agent",
                "kind": "main",
                "label": "POST /v1/runs/{id}/input",
                "note": "the run stops"
              }
            ]
          }
        ]
      },
      {
        "from": "agent",
        "to": "svc",
        "kind": "dashed",
        "label": "done",
        "note": "outcome: completed",
        "deactivate": true
      }
    ]
  },
