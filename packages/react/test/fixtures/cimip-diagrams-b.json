  "flowchart": {
    "type": "flowchart",
    "title": "Who may decide what the agent asks to run",
    "source": "docs/agent-contract.md and the approvals section of the architecture",
    "summary": "When the agent asks to run a command, CIMIP sets the higher of the two risk levels, then checks the decider's role: observers cannot decide, commanders and deputies may always decide, responders may decide only at medium risk or lower, and the first recorded decision stands.",
    "legend": {
      "main": "Usual path",
      "focal": "CIMIP's own step"
    },
    "nodes": [
      {
        "id": "req",
        "shape": "terminal",
        "name": "Agent asks to run a command",
        "detail": "approval.requested",
        "detailMono": true,
        "col": 2,
        "row": 1
      },
      {
        "id": "risk",
        "name": "CIMIP sets the risk",
        "detail": "higher of the agent's and its own",
        "focal": true,
        "col": 2,
        "row": 2
      },
      {
        "id": "who",
        "shape": "decision",
        "name": "Who is deciding?",
        "col": 2,
        "row": 3
      },
      {
        "id": "obs",
        "shape": "terminal",
        "name": "Can't decide",
        "detail": "observers only read",
        "col": 1,
        "row": 3,
        "branch": true
      },
      {
        "id": "med",
        "shape": "decision",
        "name": "Risk medium or lower?",
        "col": 3,
        "row": 3,
        "branch": true
      },
      {
        "id": "wait",
        "shape": "terminal",
        "name": "Waits for the commander or deputy",
        "col": 4,
        "row": 3,
        "branch": true
      },
      {
        "id": "may",
        "name": "May decide",
        "detail": "high risk asks twice",
        "col": 2,
        "row": 4
      },
      {
        "id": "first",
        "shape": "decision",
        "name": "First decision?",
        "col": 2,
        "row": 5
      },
      {
        "id": "told",
        "shape": "terminal",
        "name": "Told it was already decided",
        "col": 1,
        "row": 5,
        "branch": true
      },
      {
        "id": "rec",
        "shape": "terminal",
        "name": "Recorded, then sent until acknowledged",
        "col": 2,
        "row": 6
      }
    ],
    "edges": [
      {
        "from": "req",
        "to": "risk",
        "kind": "main"
      },
      {
        "from": "risk",
        "to": "who",
        "kind": "main"
      },
      {
        "from": "who",
        "to": "obs",
        "label": "observer"
      },
      {
        "from": "who",
        "to": "med",
        "label": "responder"
      },
      {
        "from": "who",
        "to": "may",
        "kind": "main",
        "label": "commander or deputy"
      },
      {
        "from": "med",
        "to": "wait",
        "label": "no"
      },
      {
        "from": "med",
        "to": "may",
        "label": "yes",
        "fromSide": "bottom",
        "toSide": "right"
      },
      {
        "from": "may",
        "to": "first",
        "kind": "main"
      },
      {
        "from": "first",
        "to": "told",
        "label": "no"
      },
      {
        "from": "first",
        "to": "rec",
        "kind": "main",
        "label": "yes"
      }
    ]
