{
  "color": {
    "$type": "color",
    "syntax": {
      "keyword": {
        "$value": { "colorSpace": "oklch", "components": [0.8, 0.09, 255] },
        "$description": "Code keywords and storage declarations, and markup tags; blue. Operators and punctuation stay neutral."
      },
      "string": {
        "$value": { "colorSpace": "oklch", "components": [0.8, 0.09, 150] },
        "$description": "Code strings and quoted values; green. Never used as a success indicator."
      },
      "constant": {
        "$value": { "colorSpace": "oklch", "components": [0.8, 0.09, 70] },
        "$description": "Code numbers, booleans and constants; amber. Never used as a warning indicator."
      },
      "function": {
        "$value": { "colorSpace": "oklch", "components": [0.8, 0.09, 305] },
        "$description": "Code functions, types and classes; purple."
      },
      "comment": {
        "$value": "{color.text.tertiary}",
        "$description": "Code comments; quiet, but still at least 4.5:1 on the code surface. No italic font is required."
      }
    },
    "surface": {
      "$description": "The page is the darkest layer; every raised layer steps lighter. Nothing above the page is pure black, so large surfaces never smear on OLED.",
      "page": {
        "$value": "{color.neutral.0}",
        "$description": "The page, and app sidebars. The darkest layer in both themes."
      },
      "raised": {
        "$value": "{color.neutral.4}",
        "$description": "Cards, tables, inputs and secondary buttons, on surface-page."
      },
      "overlay": {
        "$value": "{color.neutral.7}",
        "$description": "Menus, popovers, selects and dialogs."
      },
      "top": {
        "$value": "{color.neutral.9}",
        "$description": "Tooltips, and the selected pill of a segmented control."
      },
      "sunken": {
        "$value": "{color.neutral.4}",
        "$description": "Wells and code blocks, set into a raised surface."
      },
      "sunken-strong": {
        "$value": "{color.neutral.7}",
        "$description": "Table headers and segmented-control tracks."
      },
      "placeholder": {
        "$value": "{color.neutral.9}",
        "$description": "Skeletons and other loading placeholders: visible on the page in both themes."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.93}",
        "$description": "Body text, headings and labels, on every surface."
      },
      "secondary": {
        "$value": "{color.neutral.63}",
        "$description": "Descriptions, metadata, unselected tabs and icons by default. Also the focus colour."
      },
      "tertiary": {
        "$value": "{color.neutral.52}",
        "$description": "Placeholders, shortcuts and hashes. On a hover or selected wash, use text-secondary instead."
      },
      "disabled": {
        "$value": "{color.neutral.36}",
        "$description": "Disabled controls only (exempt from WCAG contrast); never for readable content."
      },
      "inverse": {
        "$value": "{color.neutral.0}",
        "$description": "Text on action-primary fills."
      }
    },
    "border": {
      "hairline": {
        "$value": "{color.white.15}",
        "$description": "Decorative 1px lines around cards, tables and secondary buttons, via shadow-hairline."
      },
      "hover": {
        "$value": "{color.white.24}",
        "$description": "The hairline of a hovered control: one step brighter, never a colour."
      },
      "divider": {
        "$value": "{color.white.10}",
        "$description": "Rules between table rows, menu groups and card sections."
      },
      "input": {
        "$value": "{color.white.38}",
        "$description": "Input boundaries: 3:1 or better on every surface (WCAG 1.4.11)."
      },
      "focus": {
        "$value": "{color.neutral.63}",
        "$description": "The 2px focus outline, offset 2px, on every focusable control."
      }
    },
    "state": {
      "hover": {
        "$value": "{color.white.6}",
        "$description": "Hover wash over any surface; menu highlight."
      },
      "selected": {
        "$value": "{color.white.9}",
        "$description": "Selected wash, with a second cue (a bar, a pill, a check): a wash alone is about 1.2:1."
      }
    },
    "action": {
      "primary": {
        "$value": "{color.neutral.93}",
        "$description": "The one primary action per view: the inverse of the page."
      },
      "primary-hover": {
        "$value": "{color.neutral.100}",
        "$description": "action-primary on hover: pure white on dark, pure black on light."
      },
      "primary-text": {
        "$value": "{color.neutral.0}",
        "$description": "Text on action-primary."
      }
    },
    "status": {
      "danger": {
        "$value": "{color.status.danger-dark}",
        "$description": "Destructive actions and errors: red text, red hairline, a dot. Never a fill."
      },
      "success": {
        "$value": "{color.status.success-dark}",
        "$description": "A success or healthy dot, always beside a word."
      },
      "warning": {
        "$value": "{color.status.warning-dark}",
        "$description": "A warning or in-progress dot, always beside a word."
      }
    },
    "scrim": {
      "$value": "{color.black.80}",
      "$description": "Behind modal dialogs and sheets."
    }
  },
  "shadow": {
    "$description": "The second ring is the page colour behind the hairline, so the translucent line mixes against the same colour on any background.",
