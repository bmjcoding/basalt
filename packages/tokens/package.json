{
  "name": "@srasyndicate/basalt-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Basalt design tokens: one DTCG source, built for CSS, TypeScript, JSON and Swift.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./tokens.css": "./dist/css/tokens.css",
    "./accents.css": "./dist/css/accents.css",
    "./shadcn.css": "./dist/css/shadcn.css",
    "./breakpoints.css": "./dist/css/breakpoints.css",
    "./base.css": "./dist/css/base.css",
    "./palette-base.css": "./dist/css/palette-base.css",
    "./palettes/beryl.css": "./dist/css/palettes/beryl.css",
    "./tokens.json": "./dist/json/tokens.json",
    "./breakpoints": {
      "types": "./dist/js/breakpoints.d.ts",
      "default": "./dist/js/breakpoints.js"
    },
    "./durations": {
      "types": "./dist/js/durations.d.ts",
      "default": "./dist/js/durations.js"
    },
    "./palettes": {
      "types": "./dist/js/palettes.d.ts",
      "default": "./dist/js/palettes.js"
    },
    "./palettes/beryl": {
      "types": "./dist/js/beryl.d.ts",
      "default": "./dist/js/beryl.js"
    },
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    }
  },
  "files": [
    "dist",
    "tokens",
    "bin",
    "palettes"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test --test-timeout=120000 test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "culori": "4.0.2",
    "style-dictionary": "5.7.0"
  },
  "bin": {
    "basalt-palette": "./bin/basalt-palette.mjs"
  }
}
